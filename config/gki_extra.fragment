# gki_defconfig 追加项（照 cctv18 的配方）
# 他们只往 gki_defconfig 里加这些，不碰任何 MTK 驱动——因为这台机器的存储/显示
# 等必需驱动都在 vendor_dlkm 里以模块形式存在，纯 GKI 内核 + OEM 模块即可启动。

# Mountify（backslashxx/mountify）需要
CONFIG_TMPFS_XATTR=y
CONFIG_TMPFS_POSIX_ACL=y

# 编译优化（-O2）
CONFIG_CC_OPTIMIZE_FOR_PERFORMANCE=y

# 注意：不要设 CONFIG_HEADERS_INSTALL=n。
# SukiSU builtin 的 drivers/kernelsu/Makefile 会检查 $(obj)/usr/include 是否存在，
# 缺了就把 preinit 关掉（"KernelSU: ./usr/include not found, preinit disabled"），
# 而 SUSFS 补丁的 fs/exec.c 又引用 ksu_preinit_handle_post_execveat ->
# 链接期 undefined symbol。(cctv18 用 KernelSU-Next 不依赖它，所以他能省。)

# 抓崩溃现场用
CONFIG_PSTORE=y
CONFIG_PSTORE_RAM=y
CONFIG_PSTORE_CONSOLE=y
CONFIG_PSTORE_PMSG=y
