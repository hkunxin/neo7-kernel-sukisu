fs/namespace.c 补丁修正（替代 50_add_susfs 中唯一必然失败的 hunk）

背景：50_add_susfs_in_gki-android14-6.1.patch 的 fs/namespace.c 第 1 个 hunk 用
`#include <trace/hooks/blk.h>` 作后置上下文，但 OnePlusOSS MT6989 树的 namespace.c
没有这一行，patch 在 -F3 下仍然拒绝该 hunk（其余 9 个 hunk 全部成功）。

该 hunk 的作用只是引入 susfs_def.h 和 SUS_MOUNT 用的两个 extern，本文件按本树
实际上下文重写同一段插入。应用顺序：主补丁 → 本 fixup → 清理 .rej → 校验。

--- a/fs/namespace.c
+++ b/fs/namespace.c
@@ -32,10 +32,20 @@
 #include <linux/fs_context.h>
 #include <linux/shmem_fs.h>
 #include <linux/mnt_idmapping.h>
+#ifdef CONFIG_KSU_SUSFS
+#include <linux/susfs_def.h>
+#endif // #ifdef CONFIG_KSU_SUSFS
 
 #include "pnode.h"
 #include "internal.h"
 
+#ifdef CONFIG_KSU_SUSFS_SUS_MOUNT
+extern bool susfs_is_current_ksu_domain(void);
+extern struct static_key_true susfs_is_sdcard_android_data_not_decrypted;
+
+#define CL_COPY_MNT_NS BIT(25) /* used by copy_mnt_ns() */
+#endif // #ifdef CONFIG_KSU_SUSFS_SUS_MOUNT
+
 /* Maximum number of mounts in a mount namespace */
 static unsigned int sysctl_mount_max __read_mostly = 100000;
